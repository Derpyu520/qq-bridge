{
  "_comment": "本地专用规则模板。复制为 privacy-rules.json 后填写你自己的真实标识；privacy-rules.json 必须加进 .gitignore（它含你的 QQ 号/路径）。本模板本身不含真实数据，可以入库。",
  "deny": [
    { "name": "示例：我的管理员 QQ", "pattern": "(?<![0-9])1[0-9]{9}(?![0-9])", "flags": "" },
    { "name": "示例：我的机器用户名", "pattern": "C:\\\\Users\\\\<你的用户名>\\\\", "flags": "i" },
    { "name": "示例：我的工作盘", "pattern": "D:\\\\<你的目录>\\\\", "flags": "i" }
  ],
  "denyFiles": [
    "notes/",
    "*.private.md"
  ],
  "allowPaths": [
    "docs/guides/VOICE.md",
    "scripts/console-ui-"
  ]
}
